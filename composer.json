{
    "name": "provemark/c2pa-verifier",
    "description": "Verifier for C2PA Content Credentials in pure PHP: reads the manifest store out of a file and checks signature, hash binding, certificate chain and timestamp, with c2patool's verdict semantics. Read and verify only; no signing.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "c2pa",
        "content-credentials",
        "provenance",
        "verifier",
        "jumbf",
        "cbor",
        "cose"
    ],
    "authors": [
        {
            "name": "Maurice van Loon"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.2",
        "provemark/content-credentials": "^0.15"
    },
    "suggest": {
        "ext-sodium": "EdDSA (Ed25519) claim signatures: required on PHP 8.3, where ext-openssl cannot verify Ed25519; optional on PHP 8.4+ (SPEC-009 AC8, measured on CI 2026-09-21)"
    },
    "autoload": {
        "psr-4": {
            "Provemark\\C2paVerifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Provemark\\C2paVerifier\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "spec-check": "php bin/spec-check.php",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "deptrac": "deptrac analyse --no-progress",
        "test": "pest",
        "check": [
            "@spec-check",
            "@lint",
            "@analyse",
            "@deptrac",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check": "The single definition of green: spec-check, Pint (test mode), PHPStan level max, Deptrac, Pest."
    }
}
