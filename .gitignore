# --- Secrets: NEVER commit. This project verifies only; no private key has any
# business here, test key or otherwise. Public test certificates are fine. ---
.env
.env.*
!.env.example
*.key
*.pk8
# the conformance-test generator's key directory (SPEC-078), should one ever land here
conformance-test-keys-*/

# --- PHP / Composer ---
/vendor/
composer.lock
.phpunit.cache/
.phpunit.result.cache
.phpstan.cache/
.deptrac.cache
.php-cs-fixer.cache

# --- Build artifacts and local tools (c2patool binary is downloaded, never committed) ---
out/
# tools/ holds downloaded binaries (c2patool), which are never committed; the
# second-oracle program under tools/go-oracle/ is source, and is (step 61), and
# so is the c2pa-web comparison under tools/web-oracle/ (step 348).
tools/*
!tools/go-oracle/
!tools/web-oracle/

# --- Editors / OS ---
.idea/
.DS_Store

# Local project instructions (not published)
CLAUDE.md
